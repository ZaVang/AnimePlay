        {
            "images": {
                "small": "https://lain.bgm.tv/r/100/pic/crt/l/8e/bd/68718_crt_8ZUE9.jpg?r=1609449781",
                "grid": "https://lain.bgm.tv/pic/crt/g/8e/bd/68718_crt_8ZUE9.jpg?r=1609449781",
